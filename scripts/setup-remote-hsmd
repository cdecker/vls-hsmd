#!/bin/bash

set -e

make_link()
{
    have=$(realpath --relative-to=$2 $1)
    ln -sf $have $2
}

make_link vls/lightning-signer-server/src/server/remotesigner.proto remote_hsmd/
make_link remote_hsmd lightning/contrib/
make_link bin/remote_hsmd_vls lightning/lightningd/
make_link bin/remote_hsmd_socket_test lightning/lightningd/
make_link bin/remote_hsmd_serial lightning/lightningd/
