     build-essential \
     ca-certificates \
     eatmydata \
     git \
     jq \
     libgrpc++-dev \
     libsqlite3-dev \
     libtool \
     pigz \
     pkg-config \
     postgresql \
     protobuf-compiler \
     protobuf-compiler-grpc \
     python-is-python3 \
     python3 \
     python3-dev \
     python3-mako \
     python3-pip \
     python3-pkg-resources \
     python3-setuptools \
     sudo \
     tzdata \
     zip \
     $(NULL)
#pip3 install --break-system-packages --upgrade pip
pip3 install --user poetry==1.3.2 poetry-core==1.4.0
